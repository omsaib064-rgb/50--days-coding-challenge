🐍 Python Example
import pandas as pd

df = pd.read_csv("cyberbullying.csv")

# Remove duplicates
df.drop_duplicates(inplace=True)

# Remove null comments
df.dropna(subset=['comment_text'], inplace=True)

# Toxic comments by platform
platform = df.groupby('platform').size()

print(platform)
