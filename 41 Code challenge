📌 Task 5: Advanced DAX
✅ Top Performing Product
Top Product =
CALCULATE(
    SELECTEDVALUE(Sheet1[Product]),
    TOPN(
        1,
        VALUES(Sheet1[Product]),
        [Total Revenue],
        DESC
    )
)
✅ Loss Flag
Loss Flag =
IF(
    Sheet1[Profit] < 0,
    "Loss",
    "Profit"
)
✅ Dynamic Title
Title =
"Financial Dashboard - " &
SELECTEDVALUE(Sheet1[Region])
