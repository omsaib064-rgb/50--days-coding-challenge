⚙ Business Rules
Age Based Rules
Age below 25 → Add 20%
Age between 25 and 45 → No change
Age above 45 → Add 15%
Claim Based Rules
Claims more than 2 → Add 25%
Claims equal to 0 → Give 10% discount
💻 Python Code
def calculate_premium(age, policy_type, claims):

    premiums = {
        "health": 8000,
        "vehicle": 12000,
        "life": 10000
    }

    if policy_type not in premiums:
        return None

    premium = premiums[policy_type]

    # Age adjustment
    if age < 25:
        premium += premium * 0.20

    elif age > 45:
        premium += premium * 0.15

    # Claims adjustment
    if claims > 2:
        premium += premium * 0.25

    elif claims == 0:
        premium -= premium * 0.10

    return premium


# Inputs
name = input("Enter Customer Name: ")
age = int(input("Enter Age: "))
policy_type = input("Enter Policy Type (health/vehicle/life): ").lower()
claims = int(input("Enter Number of Claims: "))

# Calculate Premium
final_premium = calculate_premium(age, policy_type, claims)

# Output
if final_premium is None:
    print("Invalid policy type entered!")

else:
    base_prices = {
        "health": 8000,
        "vehicle": 12000,
        "life": 10000
    }

    print("\n===== Insurance Premium Details =====")
    print("Customer Name :", name)
    print("Policy Type   :", policy_type)
    print("Base Premium  : ₹", base_prices[policy_type])
    print("Final Premium : ₹", int(final_premium))
