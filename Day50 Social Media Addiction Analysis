🗄 SQL Queries Used
SELECT Platform, AVG(Daily_Usage_Hours)
FROM social_media
GROUP BY Platform;
SELECT Addiction_Level, COUNT(*)
FROM social_media
GROUP BY Addiction_Level;
SELECT Age_Group, AVG(Productivity_Score)
FROM social_media
GROUP BY Age_Group;
